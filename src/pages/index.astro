---
// ここはフロントマター（設定エリア）です。
// レイアウトをインポートしたり、フォントを設定したりします。
import Layout from "../layouts/Layout.astro";
import "@fontsource/m-plus-1";
import { getCollection } from 'astro:content';
const projects = await getCollection('projects');
---

