---
const { content } = Astro.props;
---
<div class="prose prose-slate lg:prose-xl">
  <p class="leading-relaxed text-gray-700 whitespace-pre-wrap">
    {content}
  </p>
</div>
<div class="mt-10 aspect-video bg-orange-100 rounded-xl flex items-center justify-center text-orange-300">
  画像や図表を準備中
</div>
